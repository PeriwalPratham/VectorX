#include <Wire.h>
#include <VL53L0X.h>
#include <Servo.h>
#include <math.h>

VL53L0X leftSensor;
VL53L0X rightSensor;
Servo steeringServo;

// Motor Pins
const int pwmPin = 11;
const int dirPin = 13;

// Servo & Steering Angles
const int SERVO_PIN = 9;
const int STRAIGHT = 89;
const int RIGHT = 69;
const int LEFT = 119;

// XSHUT Pins
const int LEFT_XSHUT = 6;
const int RIGHT_XSHUT = 7;

// --- DYNAMIC & FIXED SPEED TUNING ---
const int DRIVE_SPEED_MAX = 255;       // Maximum speed for normal driving
const int DRIVE_SPEED_MIN = 200;       // Minimum speed during hard steering corrections
const int TURN_SPEED = 230;            // Speed maintained through turns
const int PARKING_MEASURE_PWM = 220;   // FIXED LOCKED PWM for distance/time linear measurement

// --- PARKING TIMING & COMPENSATION ---
// Adjust 1.04 - 1.08 to compensate for Lap 3 battery voltage drop slowing down motors
const float BATTERY_DECAY_FACTOR = 1.05; 

unsigned long T_start = 0;             // Time taken for start leg (Boot to Turn 1)
unsigned long fullStraightStartTime = 0;
unsigned long T_full_sum = 0;          // Accumulated total time of full straights
int fullStraightCount = 0;            // Total full straights measured
unsigned long T_target_park = 0;       // Calculated target run time for parking leg
unsigned long parkingStartTime = 0;

// --- CORNERING TIMING ---
const unsigned long WAIT_AFTER_WALL_MS = 180;   
const unsigned long DRIVE_GRACE_PERIOD_MS = 400; 

const int WALL_LOST_CONFIRM_COUNT = 4; 
const float TURN_TOLERANCE = 10.0;     

// --- GYRO & PD TUNING ---
const float KP_STRAIGHT = 1.3;

// PD Wall Following Gains
const float KP_WALL = 0.22;            
const float KD_WALL = 0.11;            
const float DEFAULT_INNER_SETPOINT = 250.0; 

const int TOF_MAX_VALID = 1200;        
const int WALL_LOST_THRESHOLD = 1000;  

bool leftSensorOK = false;

// Dynamic Track Auto-Detection
bool innerIsLeft = false;              
bool trackLayoutDetected = false;

// PD Tracking Variables
float lastError = 0.0;
unsigned long lastPDTime = 0;

// ---------- MPU ----------
#define MPU_ADDR 0x68
float gyroOffsetZ = 0;
float heading = 0;
unsigned long lastTime;

// ---------- Timers & Counters ----------
int wallLostCounter = 0;
unsigned long driveStartTime = 0;
unsigned long waitStart = 0;

// ---------- State Machine ----------
enum RobotState
{
  DRIVE,
  WAIT_AFTER_WALL,
  TURN_CORNER,
  WAIT_FOR_WALL,
  PARK_FINAL_LEG,
  STOPPED
};

RobotState state = DRIVE;
float targetHeading = 0;
int cornerCount = 0;       
int lapCount = 0;          
const int TARGET_LAPS = 3;

// Circular Math Engine
float getAngleError(float current, float target) {
  float error = current - target;
  while (error > 180.0) error -= 360.0;
  while (error < -180.0) error += 360.0;
  return error;
}

// PD Steering Calculation with Cosine Projection
int calculatePDWallSteer(uint16_t rawLeft, uint16_t rawRight, float headingError) {
  unsigned long now = millis();
  float dt = (now - lastPDTime) / 1000.0;
  if (dt <= 0.001) dt = 0.001; 
  lastPDTime = now;

  float angleRad = headingError * (M_PI / 180.0);
  float cosFactor = cos(angleRad);
  if (cosFactor < 0.2) cosFactor = 0.2; 

  bool leftValid = (leftSensorOK && !leftSensor.timeoutOccurred() && rawLeft < TOF_MAX_VALID && rawLeft > 0);
  bool rightValid = (!rightSensor.timeoutOccurred() && rawRight < TOF_MAX_VALID && rawRight > 0);

  float trueLeft = leftValid ? (rawLeft * cosFactor) : 9999.0;
  float trueRight = rightValid ? (rawRight * cosFactor) : 9999.0;

  float error = 0.0;

  if (innerIsLeft) {
    if (leftValid && rightValid) {
      float targetInner = trueRight / 3.0;
      error = trueLeft - targetInner; 
    } else if (leftValid) {
      error = trueLeft - DEFAULT_INNER_SETPOINT;
    } else {
      lastError = 0;
      return 0;
    }
  } 
  else {
    if (leftValid && rightValid) {
      float targetInner = trueLeft / 3.0;
      error = targetInner - trueRight; 
    } else if (rightValid) {
      error = DEFAULT_INNER_SETPOINT - trueRight;
    } else {
      lastError = 0;
      return 0;
    }
  }

  float dError = (error - lastError) / dt;
  lastError = error;

  float pdOutput = (KP_WALL * error) + (KD_WALL * dError);

  return constrain((int)pdOutput, -15, 15);
}

void setup() {
  Serial.begin(115200);
  pinMode(pwmPin, OUTPUT);
  pinMode(dirPin, OUTPUT);
  steeringServo.attach(SERVO_PIN);
  steeringServo.write(STRAIGHT);
  stopMotor();

  Wire.begin();
  Wire.setClock(400000); 

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B);        
  Wire.write(0x00);        
  Wire.endTransmission(true);
  delay(50);

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x1A); 
  Wire.write(0x03); 
  Wire.endTransmission(true);

  pinMode(LEFT_XSHUT, OUTPUT);
  pinMode(RIGHT_XSHUT, OUTPUT);

  digitalWrite(LEFT_XSHUT, LOW);
  digitalWrite(RIGHT_XSHUT, LOW);
  delay(10);

  digitalWrite(LEFT_XSHUT, HIGH);
  delay(10);
  leftSensorOK = leftSensor.init();
  if (leftSensorOK) {
    leftSensor.setAddress(0x30);
    leftSensor.setTimeout(50);
    leftSensor.setMeasurementTimingBudget(20000); 
    leftSensor.startContinuous();
  }

  digitalWrite(RIGHT_XSHUT, HIGH);
  delay(10);
  if (!rightSensor.init()) {
    while (1); 
  }
  rightSensor.setAddress(0x31);
  rightSensor.setTimeout(50);
  rightSensor.setMeasurementTimingBudget(20000); 
  rightSensor.startContinuous();

  calibrateGyro();
  lastTime = micros();
  lastPDTime = millis();
  targetHeading = 0;
  driveStartTime = millis();
}

void loop()
{
  updateHeading();
  
  uint16_t rightDistance = rightSensor.readRangeContinuousMillimeters();
  uint16_t leftDistance = leftSensorOK ? leftSensor.readRangeContinuousMillimeters() : 65535;

  // AUTO-DETECT CENTER/INNER WALL AT START
  if (!trackLayoutDetected && (millis() - driveStartTime > 80)) {
    innerIsLeft = (leftDistance < rightDistance);
    trackLayoutDetected = true;
  }

  switch(state)
  {
    //---------------- DRIVE ----------------
    case DRIVE:
      {
        float headingError = getAngleError(heading, targetHeading);
        int gyroSteer = (int)(headingError * KP_STRAIGHT);
        int wallSteer = calculatePDWallSteer(leftDistance, rightDistance, headingError);

        int targetServo = constrain(STRAIGHT + gyroSteer + wallSteer, RIGHT, LEFT);
        steeringServo.write(targetServo);

        moveForward(PARKING_MEASURE_PWM);

        bool immunityActive = (millis() - driveStartTime < DRIVE_GRACE_PERIOD_MS);

        uint16_t innerDistance = innerIsLeft ? leftDistance : rightDistance;
        bool innerSensorError = innerIsLeft ? (leftSensor.timeoutOccurred() || !leftSensorOK) : rightSensor.timeoutOccurred();
        
        bool isInnerWallLost = innerSensorError || 
                               innerDistance == 8191 || 
                               innerDistance == 65535 || 
                               innerDistance > WALL_LOST_THRESHOLD;

        if (isInnerWallLost && !immunityActive) {
            wallLostCounter++;
        } else {
            wallLostCounter = 0; 
        }

        if (wallLostCounter >= WALL_LOST_CONFIRM_COUNT) {
            // 75 ms buffer delay before switching states
            delay(75);

            wallLostCounter = 0;
            waitStart = millis();

            // Store precise straight durations upon confirming wall loss
            if (cornerCount == 0) {
              T_start = waitStart - driveStartTime; // Initial partial leg duration
            } else {
              T_full_sum += (waitStart - fullStraightStartTime); // Full straight duration
              fullStraightCount++;
            }

            state = WAIT_AFTER_WALL;
        }
      }
      break;

    //---------------- WAIT AFTER WALL ----------------
    case WAIT_AFTER_WALL:
      {
        float headingError = getAngleError(heading, targetHeading);
        int gyroSteer = (int)(headingError * KP_STRAIGHT);
        steeringServo.write(constrain(STRAIGHT + gyroSteer, RIGHT, LEFT));
        moveForward(PARKING_MEASURE_PWM);

        if (millis() - waitStart >= WAIT_AFTER_WALL_MS) {
           if (innerIsLeft) {
             targetHeading -= 90.0; 
           } else {
             targetHeading += 90.0; 
           }
           
           if (targetHeading >= 360.0) targetHeading -= 360.0;
           if (targetHeading < 0.0) targetHeading += 360.0;

           steeringServo.write(innerIsLeft ? LEFT : RIGHT);
           moveForward(TURN_SPEED); 
           state = TURN_CORNER;
        }
      }
      break;

    //---------------- TURN CORNER ----------------
    case TURN_CORNER:
      {
        steeringServo.write(innerIsLeft ? LEFT : RIGHT);
        moveForward(TURN_SPEED);

        float remainingAngle = getAngleError(heading, targetHeading);

        if (abs(remainingAngle) <= TURN_TOLERANCE) {
          steeringServo.write(STRAIGHT);
          cornerCount++;

          if (cornerCount % 4 == 0) {
              lapCount++;
          }

          // Always go to WAIT_FOR_WALL to re-establish proper timing baseline
          moveForward(PARKING_MEASURE_PWM);
          waitStart = millis(); 
          state = WAIT_FOR_WALL;
        }
      }
      break;

    //---------------- WAIT FOR WALL ----------------
    case WAIT_FOR_WALL:
      {
        float headingError = getAngleError(heading, targetHeading);
        int gyroSteer = (int)(headingError * KP_STRAIGHT);
        int wallSteer = calculatePDWallSteer(leftDistance, rightDistance, headingError);

        int targetServo = constrain(STRAIGHT + gyroSteer + wallSteer, RIGHT, LEFT);
        steeringServo.write(targetServo);

        moveForward(PARKING_MEASURE_PWM);

        uint16_t innerDistance = innerIsLeft ? leftDistance : rightDistance;
        bool innerSensorOK_Check = innerIsLeft ? !leftSensor.timeoutOccurred() : !rightSensor.timeoutOccurred();

        bool innerWallReacquired = (innerSensorOK_Check && innerDistance < TOF_MAX_VALID && innerDistance > 0);
        bool timeoutTriggered = (millis() - waitStart > 1200);

        if (innerWallReacquired || timeoutTriggered) {
            wallLostCounter = 0;
            driveStartTime = millis(); 
            fullStraightStartTime = driveStartTime; 

            // After 12 corners, initiate parking from the wall re-acquisition baseline
            if (cornerCount >= 12) {
              unsigned long T_full_avg = (fullStraightCount > 0) ? (T_full_sum / fullStraightCount) : T_start;
              
              if (T_full_avg > T_start) {
                T_target_park = (unsigned long)((T_full_avg - T_start) * BATTERY_DECAY_FACTOR);
              } else {
                T_target_park = 0;
              }

              parkingStartTime = millis();
              state = PARK_FINAL_LEG;
            } else {
              state = DRIVE;
            }
        }
      }
      break;

    //---------------- PARK FINAL LEG ----------------
    case PARK_FINAL_LEG:
      {
        float headingError = getAngleError(heading, targetHeading);
        int gyroSteer = (int)(headingError * KP_STRAIGHT);
        int wallSteer = calculatePDWallSteer(leftDistance, rightDistance, headingError);

        int targetServo = constrain(STRAIGHT + gyroSteer + wallSteer, RIGHT, LEFT);
        steeringServo.write(targetServo);
        moveForward(PARKING_MEASURE_PWM);

        if (millis() - parkingStartTime >= T_target_park) {
            activeBrake();
            state = STOPPED;
        }
      }
      break;

    case STOPPED:
      stopMotor();
      break;
  }
}

void moveForward(int speedValue) {
  digitalWrite(dirPin, HIGH);
  analogWrite(pwmPin, speedValue);
}

void activeBrake() {
  digitalWrite(dirPin, LOW);
  analogWrite(pwmPin, 200);
  delay(80);
  analogWrite(pwmPin, 0);
}

void stopMotor() {
  analogWrite(pwmPin, 0);
}

void updateHeading() {
  float gyroZ = readGyroZ();
  unsigned long now = micros();
  float dt = (now - lastTime) / 1000000.0;
  lastTime = now;
  
  heading += gyroZ * dt;
  
  while (heading >= 360.0) heading -= 360.0;
  while (heading < 0.0) heading += 360.0;
}

void calibrateGyro() {
  long sum = 0;
  const int samples = 150; 
  for (int i = 0; i < samples; i++) {
    Wire.beginTransmission(MPU_ADDR);
    Wire.write(0x47);
    Wire.endTransmission(false);
    Wire.requestFrom(MPU_ADDR, 2, true);
    int16_t gz = Wire.read() << 8 | Wire.read();
    sum += gz;
    delay(1);
  }
  gyroOffsetZ = (sum / (float)samples) / 131.0;
}

float readGyroZ() {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x47);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU_ADDR, 2, true);
  int16_t gz = Wire.read() << 8 | Wire.read();
  return -((gz / 131.0) - gyroOffsetZ);
}
