#include <Wire.h>
#include <VL53L0X.h>
#include <Servo.h>
#include <math.h>

VL53L0X leftSensor;
VL53L0X rightSensor;
Servo steeringServo;

// Motor Pins
const int pwmPin = 11;
const int dirPin = 13;

// Servo & Steering Angles (Center 82, ±20 limit)
const int SERVO_PIN = 9;
const int STRAIGHT = 82;
const int RIGHT = 62;
const int LEFT = 102;

// XSHUT Pins
const int LEFT_XSHUT = 6;
const int RIGHT_XSHUT = 7;

// --- HIGH-SPEED SPEED & TIMING TUNING ---
const int DRIVE_SPEED = 210;          
const int TURN_SPEED = 180;           

const unsigned long WAIT_AFTER_WALL_MS = 120;   
const unsigned long DRIVE_GRACE_PERIOD_MS = 350; 

const int WALL_LOST_CONFIRM_COUNT = 5; 
const float TURN_TOLERANCE = 10.0;     

// --- GYRO & HEADING KP ---
const float KP_STRAIGHT = 1.2;

// --- HIGH-SPEED PD CONTROL TUNING ---
const float KP_WALL = 0.12;            
const float KD_WALL = 0.12;            
const float DEFAULT_INNER_SETPOINT = 250.0; 

const int TOF_MAX_VALID = 1200;        
const int WALL_LOST_THRESHOLD = 1000;   

// Dynamic Track Safety Thresholds
const float WALL_TOO_CLOSE_MM = 160.0;
const float WALL_TOO_FAR_MM = 400.0;

bool leftSensorOK = false;

// Dynamic Track Auto-Detection
bool innerIsLeft = false;              
bool trackLayoutDetected = false;

// PD Variables
float lastError = 0.0;
unsigned long lastPDTime = 0;
bool pdInitialized = false; // Prevents startup derivative kick

// ---------- MPU ----------
#define MPU_ADDR 0x68
float gyroOffsetZ = 0;
float heading = 0;
unsigned long lastTime;

// ---------- Timers & Counters ----------
int wallLostCounter = 0;
unsigned long driveStartTime = 0;
unsigned long waitStart = 0;

// Saved wall reading prior to starting the turn
float preTurnInnerDist = 250.0;

// ---------- State Machine ----------
enum RobotState
{
  DRIVE,
  WAIT_AFTER_WALL,
  TURN_CORNER,
  WAIT_FOR_WALL,
  STOPPED
};

RobotState state = DRIVE;
float targetHeading = 0;
int cornerCount = 0;      
int lapCount = 0;         
const int TARGET_LAPS = 3;

// Circular Math Engine
float getAngleError(float current, float target) {
  float error = current - target;
  while (error > 180.0) error -= 360.0;
  while (error < -180.0) error += 360.0;
  return error;
}

// PD Steering Calculation with Cosine Correction
int calculatePDWallSteer(uint16_t rawLeft, uint16_t rawRight, float headingError) {
  unsigned long now = millis();
  float dt = (now - lastPDTime) / 1000.0;
  if (dt <= 0.001) dt = 0.001; 
  lastPDTime = now;

  float angleRad = headingError * (M_PI / 180.0);
  float cosFactor = cos(angleRad);
  if (cosFactor < 0.2) cosFactor = 0.2; 

  bool leftValid = (leftSensorOK && !leftSensor.timeoutOccurred() && rawLeft < TOF_MAX_VALID && rawLeft > 0);
  bool rightValid = (!rightSensor.timeoutOccurred() && rawRight < TOF_MAX_VALID && rawRight > 0);

  float trueLeft = leftValid ? (rawLeft * cosFactor) : 9999.0;
  float trueRight = rightValid ? (rawRight * cosFactor) : 9999.0;

  float error = 0.0;

  if (innerIsLeft) {
    if (leftValid && rightValid) {
      float targetInner = trueRight / 3.0;
      error = trueLeft - targetInner; 
    } else if (leftValid) {
      error = trueLeft - DEFAULT_INNER_SETPOINT;
    } else {
      lastError = 0;
      return 0;
    }
  } 
  else {
    if (leftValid && rightValid) {
      float targetInner = trueLeft / 3.0;
      error = targetInner - trueRight; 
    } else if (rightValid) {
      error = DEFAULT_INNER_SETPOINT - trueRight;
    } else {
      lastError = 0;
      return 0;
    }
  }

  // FIRST RUN PROTECTION: Skip derivative kick on startup frame
  if (!pdInitialized) {
    lastError = error;
    pdInitialized = true;
    return 0; 
  }

  float dError = (error - lastError) / dt;
  lastError = error;

  float pdOutput = (KP_WALL * error) + (KD_WALL * dError);

  return constrain((int)pdOutput, -15, 15);
}

void setup() {
  Serial.begin(115200);
  pinMode(pwmPin, OUTPUT);
  pinMode(dirPin, OUTPUT);
  steeringServo.attach(SERVO_PIN);
  steeringServo.write(STRAIGHT);
  stopMotor();
  Wire.begin();

  // MPU Setup
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B);        
  Wire.write(0x00);        
  Wire.endTransmission(true);
  delay(100);

  // DLPF Filter (~42Hz)
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x1A); 
  Wire.write(0x03); 
  Wire.endTransmission(true);

  pinMode(LEFT_XSHUT, OUTPUT);
  pinMode(RIGHT_XSHUT, OUTPUT);

  digitalWrite(LEFT_XSHUT, LOW);
  digitalWrite(RIGHT_XSHUT, LOW);
  delay(10);

  // LEFT SENSOR
  digitalWrite(LEFT_XSHUT, HIGH);
  delay(10);
  leftSensorOK = leftSensor.init();
  if (leftSensorOK) {
    leftSensor.setAddress(0x30);
    leftSensor.setTimeout(100);
    leftSensor.startContinuous();
  }

  // RIGHT SENSOR
  digitalWrite(RIGHT_XSHUT, HIGH);
  delay(10);
  if (!rightSensor.init()) {
    while (1); 
  }
  rightSensor.setAddress(0x31);
  rightSensor.setTimeout(100);
  rightSensor.startContinuous();

  // Ensure car is completely stationary during calibration
  calibrateGyro();

  // WARM-UP & PRE-FLIGHT LAYOUT DETECTION (Prevents 100ms inverted control)
  delay(150); // Allow sensors to capture stable readings
  uint16_t initRight = rightSensor.readRangeContinuousMillimeters();
  uint16_t initLeft = leftSensorOK ? leftSensor.readRangeContinuousMillimeters() : 65535;

  if (initLeft < initRight) {
    innerIsLeft = true;   
  } else {
    innerIsLeft = false;  
  }
  trackLayoutDetected = true;

  // Initialize timers right before moving
  lastTime = micros();
  lastPDTime = millis();
  targetHeading = 0;
  driveStartTime = millis();
}

void loop()
{
  updateHeading();
  
  uint16_t rightDistance = rightSensor.readRangeContinuousMillimeters();
  uint16_t leftDistance = leftSensorOK ? leftSensor.readRangeContinuousMillimeters() : 65535;

  switch(state)
  {
    case DRIVE:
      {
        float headingError = getAngleError(heading, targetHeading);
        int gyroSteer = (int)(headingError * KP_STRAIGHT);

        int wallSteer = calculatePDWallSteer(leftDistance, rightDistance, headingError);

        int targetServo = STRAIGHT + gyroSteer + wallSteer;
        steeringServo.write(constrain(targetServo, RIGHT, LEFT));

        moveForward(DRIVE_SPEED);

        bool immunityActive = (millis() - driveStartTime < DRIVE_GRACE_PERIOD_MS);

        uint16_t innerDistance = innerIsLeft ? leftDistance : rightDistance;
        bool innerSensorError = innerIsLeft ? (leftSensor.timeoutOccurred() || !leftSensorOK) : rightSensor.timeoutOccurred();
        
        bool isInnerWallLost = innerSensorError || 
                               innerDistance == 8191 || 
                               innerDistance == 65535 || 
                               innerDistance > WALL_LOST_THRESHOLD;

        if (isInnerWallLost && !immunityActive) {
            wallLostCounter++;
        } else {
            if (innerDistance < TOF_MAX_VALID && innerDistance > 0) {
              preTurnInnerDist = innerDistance;
            }
            wallLostCounter = 0; 
        }

        if (wallLostCounter >= WALL_LOST_CONFIRM_COUNT) {
            wallLostCounter = 0;
            waitStart = millis();
            state = WAIT_AFTER_WALL;
        }
      }
      break;

    case WAIT_AFTER_WALL:
      {
        float headingError = getAngleError(heading, targetHeading);
        int gyroSteer = (int)(headingError * KP_STRAIGHT);
        steeringServo.write(constrain(STRAIGHT + gyroSteer, RIGHT, LEFT));
        moveForward(DRIVE_SPEED);

        if (millis() - waitStart >= WAIT_AFTER_WALL_MS) {
           
           float baseTurnAngle = 90.0;

           if (preTurnInnerDist < WALL_TOO_CLOSE_MM) {
             baseTurnAngle = 82.0; 
           } else if (preTurnInnerDist > WALL_TOO_FAR_MM) {
             baseTurnAngle = 98.0; 
           }

           if (innerIsLeft) {
             targetHeading -= baseTurnAngle; 
           } else {
             targetHeading += baseTurnAngle; 
           }
           
           if (targetHeading >= 360.0) targetHeading -= 360.0;
           if (targetHeading < 0.0) targetHeading += 360.0;

           steeringServo.write(innerIsLeft ? LEFT : RIGHT);
           moveForward(TURN_SPEED); 
           state = TURN_CORNER;
        }
      }
      break;

    case TURN_CORNER:
      {
        steeringServo.write(innerIsLeft ? LEFT : RIGHT);
        moveForward(TURN_SPEED);

        float remainingAngle = getAngleError(heading, targetHeading);

        if (abs(remainingAngle) <= TURN_TOLERANCE) {
          steeringServo.write(STRAIGHT);
          cornerCount++;

          if (cornerCount % 4 == 0) {
              lapCount++;
          }

          if (lapCount >= TARGET_LAPS) {
              stopMotor();
              state = STOPPED;
          } else {
              moveForward(DRIVE_SPEED);
              waitStart = millis(); 
              state = WAIT_FOR_WALL;
          }
        }
      }
      break;

    case WAIT_FOR_WALL:
      {
        float headingError = getAngleError(heading, targetHeading);
        int gyroSteer = (int)(headingError * KP_STRAIGHT);
        int wallSteer = calculatePDWallSteer(leftDistance, rightDistance, headingError);

        int targetServo = STRAIGHT + gyroSteer + wallSteer;
        steeringServo.write(constrain(targetServo, RIGHT, LEFT));

        moveForward(DRIVE_SPEED);

        uint16_t innerDistance = innerIsLeft ? leftDistance : rightDistance;
        bool innerSensorOK_Check = innerIsLeft ? !leftSensor.timeoutOccurred() : !rightSensor.timeoutOccurred();

        bool innerWallReacquired = (innerSensorOK_Check && innerDistance < TOF_MAX_VALID && innerDistance > 0);
        bool timeoutTriggered = (millis() - waitStart > 1200);

        if (innerWallReacquired || timeoutTriggered) {
            wallLostCounter = 0;
            driveStartTime = millis(); 
            state = DRIVE;
        }
      }
      break;

    case STOPPED:
      stopMotor();
      break;
  }
}

void moveForward(int speedValue) {
  digitalWrite(dirPin, HIGH);
  analogWrite(pwmPin, speedValue);
}

void stopMotor() {
  analogWrite(pwmPin, 0);
}

void updateHeading() {
  float gyroZ = readGyroZ();
  unsigned long now = micros();
  float dt = (now - lastTime) / 1000000.0;
  lastTime = now;
  
  heading += gyroZ * dt;
  
  while (heading >= 360.0) heading -= 360.0;
  while (heading < 0.0) heading += 360.0;
}

void calibrateGyro() {
  long sum = 0;
  const int samples = 500;
  for (int i = 0; i < samples; i++) {
    Wire.beginTransmission(MPU_ADDR);
    Wire.write(0x47);
    Wire.endTransmission(false);
    Wire.requestFrom(MPU_ADDR, 2, true);
    int16_t gz = Wire.read() << 8 | Wire.read();
    sum += gz;
    delay(10);
  }
  gyroOffsetZ = (sum / (float)samples) / 131.0;
}

float readGyroZ() {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x47);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU_ADDR, 2, true);
  int16_t gz = Wire.read() << 8 | Wire.read();
  return -((gz / 131.0) - gyroOffsetZ);
}
